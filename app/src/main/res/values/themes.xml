<resources>
    <style name="Theme.KidsLauncher" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#FF7043</item>
        <item name="android:colorAccent">#FF7043</item>
    </style>

    <style name="Theme.KidsLauncher.Home">
        <item name="android:windowBackground">@drawable/default_bg</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF5722</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#333333</item>
    </style>
</resources>
